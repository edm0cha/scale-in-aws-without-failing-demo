{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::shared-${project_name}-tfstate",
        "arn:aws:s3:::shared-${project_name}-tfstate/*"
      ]
    }
  ]
}