{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::shared-superlab-${project_name}-tfstate",
        "arn:aws:s3:::shared-superlab-${project_name}-tfstate/*"
      ]
    },
    {
      "Sid": "EC2",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:DescribeImages",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": [
        "*",
        "arn:aws:ec2:us-east-1:*:security-group/*"
      ]
    }
  ]
}