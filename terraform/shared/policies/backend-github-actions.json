{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ApiGatewayManagement",
            "Effect": "Allow",
            "Action": [
                "apigateway:GET",
                "apigateway:POST",
                "apigateway:PUT",
                "apigateway:PATCH",
                "apigateway:DELETE",
                "apigateway:TagResource"
            ],
            "Resource": [
                "arn:aws:apigateway:us-east-1::/apis",
                "arn:aws:apigateway:us-east-1::/apis/*",
                "arn:aws:apigateway:us-east-1::/domainnames",
                "arn:aws:apigateway:us-east-1::/domainnames/*",
                "arn:aws:apigateway:us-east-1::/tags/*"
            ]
        },
        {
            "Sid": "DynamoDbContactSubmissions",
            "Effect": "Allow",
            "Action": [
                "dynamodb:CreateTable",
                "dynamodb:DeleteTable",
                "dynamodb:DescribeTable",
                "dynamodb:UpdateTable",
                "dynamodb:TagResource",
                "dynamodb:UntagResource",
                "dynamodb:ListTagsOfResource",
                "dynamodb:DescribeTimeToLive",
                "dynamodb:UpdateTimeToLive",
                "dynamodb:DescribeContinuousBackups",
                "dynamodb:UpdateContinuousBackups"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-contact-submissions",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-talks",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-ratings",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-events",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-event-ratings",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-speakers",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-prizes",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-winners",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-quiz-questions",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-quiz-sessions",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-quiz-participants"
            ]
        },
        {
            "Sid": "DynamoDbStreamsForEventSourceMapping",
            "Effect": "Allow",
            "Action": [
                "dynamodb:DescribeStream",
                "dynamodb:ListStreams",
                "dynamodb:GetShardIterator",
                "dynamodb:GetRecords"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-talks/stream/*",
                "arn:aws:dynamodb:us-east-1:${account_id}:table/${project_name}-events/stream/*"
            ]
        },
        {
            "Sid": "LambdaEventSourceMappingManagement",
            "Effect": "Allow",
            "Action": [
                "lambda:CreateEventSourceMapping",
                "lambda:GetEventSourceMapping",
                "lambda:UpdateEventSourceMapping",
                "lambda:DeleteEventSourceMapping",
                "lambda:ListEventSourceMappings"
            ],
            "Resource": "*"
        },
        {
            "Sid": "LambdaCloudwatch",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:PutRetentionPolicy",
                "logs:DescribeLogGroups",
                "logs:ListTagsForResource",
                "logs:DeleteLogGroup",
                "logs:TagResource"
            ],
            "Resource": [
                "arn:aws:logs:us-east-1:${account_id}:log-group:/aws/lambda/${project_name}-rating-api:*",
                "arn:aws:logs:us-east-1:${account_id}:log-group:*"
            ]
        },
        {
            "Sid": "LambdaIAM",
            "Effect": "Allow",
            "Action": [
                "iam:GetRole",
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRolePolicy",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:ListRolePolicies",
                "iam:PassRole",
                "iam:TagRole",
                "iam:ListAttachedRolePolicies",
                "iam:ListInstanceProfilesForRole"
            ],
            "Resource": [
                "arn:aws:iam::${account_id}:role/${project_name}-rating-api-lambda",
                "arn:aws:iam::${account_id}:role/${project_name}-qr-generator-lambda",
                "arn:aws:iam::${account_id}:role/${project_name}-email-sender-lambda",
                "arn:aws:iam::${account_id}:role/${project_name}-render-summary-lambda",
                "arn:aws:iam::${account_id}:role/${project_name}-ses-event-handler-lambda",
                "arn:aws:iam::${account_id}:role/${project_name}-quiz-generator-lambda"
            ]
        },
        {
            "Sid": "SnsSesEventsTopic",
            "Effect": "Allow",
            "Action": [
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:GetTopicAttributes",
                "sns:SetTopicAttributes",
                "sns:TagResource",
                "sns:UntagResource",
                "sns:ListTagsForResource",
                "sns:Subscribe",
                "sns:Unsubscribe",
                "sns:ListSubscriptionsByTopic",
                "sns:GetSubscriptionAttributes",
                "sns:SetSubscriptionAttributes"
            ],
            "Resource": [
                "arn:aws:sns:${region}:${account_id}:${project_name}-ses-events"
            ]
        },
        {
            "Sid": "SesDomainIdentity",
            "Effect": "Allow",
            "Action": [
                "ses:VerifyDomainIdentity",
                "ses:DeleteIdentity",
                "ses:GetIdentityVerificationAttributes",
                "ses:ListIdentities",
                "ses:VerifyDomainDkim",
                "ses:GetIdentityDkimAttributes",
                "ses:SetIdentityDkimEnabled",
                "ses:TagResource",
                "ses:ListTagsForResource",
                "ses:CreateEmailIdentity",
                "ses:GetEmailIdentity",
                "ses:DeleteEmailIdentity",
                "ses:CreateConfigurationSet",
                "ses:GetConfigurationSet",
                "ses:DeleteConfigurationSet",
                "ses:CreateConfigurationSetEventDestination",
                "ses:GetConfigurationSetEventDestinations",
                "ses:DeleteConfigurationSetEventDestination"
            ],
            "Resource": [
                "arn:aws:ses:us-east-1:${account_id}:identity/${domain}",
                "arn:aws:ses:us-east-1:${account_id}:configuration-set/${project_name}-emails"
            ]
        },
        {
            "Sid": "CognitoAdminUserPoolManagement",
            "Effect": "Allow",
            "Action": [
                "cognito-idp:CreateUserPool",
                "cognito-idp:DeleteUserPool",
                "cognito-idp:DescribeUserPool",
                "cognito-idp:UpdateUserPool",
                "cognito-idp:TagResource",
                "cognito-idp:UntagResource",
                "cognito-idp:ListTagsForResource",
                "cognito-idp:CreateUserPoolClient",
                "cognito-idp:DeleteUserPoolClient",
                "cognito-idp:DescribeUserPoolClient",
                "cognito-idp:UpdateUserPoolClient",
                "cognito-idp:ListUserPoolClients",
                "cognito-idp:GetUserPoolMfaConfig",
                "cognito-idp:CreateGroup",
                "cognito-idp:GetGroup",
                "cognito-idp:DeleteGroup"
            ],
            "Resource": [
                "arn:aws:cognito-idp:us-east-1:${account_id}:userpool/*"
            ]
        },
        {
            "Sid": "LambdaContactForm",
            "Effect": "Allow",
            "Action": [
                "lambda:CreateFunction",
                "lambda:DeleteFunction",
                "lambda:GetFunction",
                "lambda:GetFunctionConfiguration",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:ListVersionsByFunction",
                "lambda:GetPolicy",
                "lambda:AddPermission",
                "lambda:RemovePermission",
                "lambda:ListTags",
                "lambda:TagResource",
                "lambda:UntagResource",
                "lambda:GetFunctionCodeSigningConfig"
            ],
            "Resource": [
                "arn:aws:lambda:${region}:${account_id}:function:${project_name}-rating-api",
                "arn:aws:lambda:${region}:${account_id}:function:${project_name}-qr-generator",
                "arn:aws:lambda:${region}:${account_id}:function:${project_name}-email-sender",
                "arn:aws:lambda:${region}:${account_id}:function:${project_name}-render-summary",
                "arn:aws:lambda:${region}:${account_id}:function:${project_name}-ses-event-handler",
                "arn:aws:lambda:${region}:${account_id}:function:${project_name}-quiz-generator",
                "arn:aws:lambda:${region}:${account_id}:event-source-mapping:*"
            ]
        }
    ]
}